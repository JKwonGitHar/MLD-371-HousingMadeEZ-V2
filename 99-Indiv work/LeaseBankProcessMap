  .key{display:flex;align-items:center;gap:8px}
  .sw{width:26px;height:18px;border-radius:4px;border:2px solid var(--edge);background:var(--fill)}
  .key svg{width:40px;height:14px;overflow:visible}
  .legend .note{border:none;padding:0;width:100%;font-size:12px}

  .caption{max-width:940px;margin-top:22px;font-size:14px}
  .sources{font-size:12px;color:var(--muted);margin-top:14px;max-width:940px}
  .sources a{color:inherit}
