  svg.wires path.w{fill:none;stroke:var(--ink);stroke-width:2}
  svg.wires path.w.u{stroke:var(--unsourced);stroke-dasharray:5 4}
  .lbl{position:absolute;z-index:4;max-width:104px;text-align:center;font-size:11.5px;font-weight:600;
       line-height:1.25;background:var(--pill);border-radius:4px;padding:1px 4px;transform:translate(-50%,-100%)}
  .lbl.u{color:var(--unsourced);font-weight:500;font-style:italic}
  .lbl.v{transform:translate(6px,-50%);text-align:left;max-width:180px}

