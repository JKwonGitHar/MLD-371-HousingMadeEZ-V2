  .bub{background:var(--fill);border:2px solid var(--edge);border-radius:10px;
       padding:10px 11px 11px;display:flex;flex-direction:column;gap:6px}
  .tag{align-self:flex-start;font-size:10.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;
       color:var(--intl);background:var(--intl-bg);border-radius:4px;padding:1px 6px}
  .title{font-weight:700;font-size:14.5px;line-height:1.25}
  .field{font-size:12.5px;line-height:1.4}
  .field b{display:block;font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);font-weight:700}
  .note{font-size:11.5px;color:var(--muted);border-top:1px solid var(--line);padding-top:6px;line-height:1.4}
  .note.warn{color:var(--warn)}
  .inferred{font-style:italic}

